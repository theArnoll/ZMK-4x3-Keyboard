#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h> // for OUT_TOG

&kscan0 {
    debounce-press-ms = <3>;
    debounce-release-ms = <3>;
};

/ {
    macros {  // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/macros
        zed_em_kay: zed_em_kay {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LSHFT>
                , <&macro_tap &kp Z &kp M &kp K>
                , <&macro_release &kp LSHFT> ;
        };

        test_macro: test_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp L &kp A &kp Y &kp E &kp R
                                &kp S &kp W &kp I &kp T &kp C &kp H> ;
        };

        swLyr: swLyr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &to 1 &kp LOCKING_NUM> ;
        };

        // Ä (Alt + 0228)
        ae_win: ae_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            // wait-ms = <10>; tap-ms = <10>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N2 &kp KP_N8>, <&macro_release &kp LALT>;
        };

        // Ö (Alt + 0246)
        oe_win: oe_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            // wait-ms = <10>; tap-ms = <10>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N4 &kp KP_N6>, <&macro_release &kp LALT>;
        };

        // Ü (Alt + 0252)
        ue_win: ue_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            // wait-ms = <10>; tap-ms = <10>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N5 &kp KP_N2>, <&macro_release &kp LALT>;
        };

        // ß (Alt + 0223)
        ss_win: ss_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            // wait-ms = <10>; tap-ms = <10>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N2 &kp KP_N3>, <&macro_release &kp LALT>;
        };
        
        // Ä (Option + U, 然後 A)
        ae_mac: ae_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            // wait-ms = <30>; tap-ms = <30>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp U>, <&macro_release &kp LALT>, <&macro_tap &kp A>;
        };

        // Ö (Option + U, 然後 O)
        oe_mac: oe_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            // wait-ms = <30>; tap-ms = <30>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp U>, <&macro_release &kp LALT>, <&macro_tap &kp O>;
        };

        // Ü (Option + U, 然後 U)
        ue_mac: ue_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            // wait-ms = <30>; tap-ms = <30>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp U>, <&macro_release &kp LALT>, <&macro_tap &kp U>;
        };

        // ß (Option + S)
        ss_mac: ss_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            // wait-ms = <30>; tap-ms = <30>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp S>, <&macro_release &kp LALT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_ae_win {
            timeout-ms = <50>;
            key-positions = <0 3>; // 請替換為你 A 和 E 實際的 ID
            bindings = <&mac_ae_win>;
            layers = <4>;
        };

        combo_oe_win {
            timeout-ms = <50>;
            key-positions = <1 3>; // 請替換為你 O 和 E 實際的 ID
            bindings = <&mac_oe_win>;
            layers = <4>;
        };

        combo_ue_win {
            timeout-ms = <50>;
            key-positions = <2 3>; // 請替換為你 U 和 E 實際的 ID
            bindings = <&mac_ue_win>;
            layers = <4>;
        };

        combo_ss_win {
            timeout-ms = <50>;
            key-positions = <3 5>; // 請替換為你 S 和 E 實際的 ID (或是你想用的組合)
            bindings = <&mac_ss_win>;
            layers = <4>;
        };
        
        combo_ae_mac {
            timeout-ms = <50>;
            key-positions = <0 3>; // 與 Windows 層保持對應的位置 ID
            bindings = <&mac_ae_mac>;
            layers = <5>;
        };

        combo_oe_mac {
            timeout-ms = <50>;
            key-positions = <1 3>; // 與 Windows 層保持對應的位置 ID
            bindings = <&mac_oe_mac>;
            layers = <5>;
        };

        combo_ue_mac {
            timeout-ms = <50>;
            key-positions = <2 3>; // 與 Windows 層保持對應的位置 ID
            bindings = <&mac_ue_mac>;
            layers = <5>;
        };

        combo_ss_mac {
            timeout-ms = <50>;
            key-positions = <3 5>; // 與 Windows 層保持對應的位置 ID
            bindings = <&mac_ss_mac>;
            layers = <5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";


        default_layer { // Layer 0
            // -------------------------------------
            // |     Z     |     M     |     K     |
            // |     A     |     B     |     C     |
            // |     D     |     E     |     F     |
            bindings = <
                &kp I    &kp 2    &kp 3
                &kp U    &kp 5    &kp J
                &kp T    &to 6    &kp G
                &kp R    &to 1    &studio_unlock
            >;
        };

        keypad_layer { // Layer 1
            bindings = <
                &kp KP_N7 &kp KP_N8 &kp KP_N9
                &kp KP_N4 &kp KP_N5 &kp KP_N6
                &kp KP_N1 &kp KP_N2 &kp KP_N3
                &kp KP_N0 &to 0     &to 6
            >;
        };

        media_layer { // Layer 2
            // kp C = J, P = L, Y = F, K = T, I = C
            bindings = <
                &kp C_VOL_UP &kp C            &kp K
                &kp C_MUTE   &kp C_PLAY_PAUSE &kp I
                &kp C_VOL_DN &kp P            &kp Y
                &kp I        &to 1            &to 6
            >;
        };

        bluetooth_layer { // Layer 3
            bindings = <
                &bt BT_SEL 0   &bt BT_SEL 1 &bt BT_SEL 2
                &bt BT_SEL 3   &bt BT_SEL 4 &bt BT_CLR 
                &bt BT_CLR_ALL &out OUT_BLE &out OUT_USB
                &to 1          &to 0        &to 6
            >;
        };

        user_define_layer1 { // Layer 4, äöüß test, Windows, Dvorak
            bindings = <
                &kp A &kp S &kp F
                &kp D &kp D &kp SEMICOLON
                &kp COMMA &kp G &kp L
                &kp R &to 0 &to 6
            >;
        };

        user_define_layer2 { // Layer 5, äöüß test, Windows, Dvorak
            bindings = <
                &kp A &kp S &kp F
                &kp D &kp D &kp SEMICOLON
                &kp M &kp A &kp I
                &kp R &to 0 &to 6
            >;
        };

        switch_layer {
            bindings = <
                &to 0  &to 1  &to 2
                &to 3  &to 4  &to 5
                &zed_em_kay  &test_macro &swLyr
                &out OUT_TOG &to 1       &studio_unlock
            >;
        };
    };
};